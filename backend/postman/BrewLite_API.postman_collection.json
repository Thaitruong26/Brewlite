{
  "info": {
    "name": "BrewLite A1 API - Postman Collection",
    "description": "Bộ sưu tập 26 API chuẩn 1:1 theo Swagger UI BrewLite Assignment 1. Hỗ trợ biến môi trường baseUrl, tự động lưu JWT token khi đăng nhập và tự sinh idempotency-key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth (Đăng ký, đăng nhập và xác thực người dùng)",
      "item": [
        {
          "name": "/api/auth/register Đăng ký tài khoản mới (role: CUSTOMER)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ],
              "variable": []
            },
            "description": "Đăng ký tài khoản mới (role: CUSTOMER)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newcustomer\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Nguyen Van A\",\n  \"phone\": \"0901234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "/api/auth/login Đăng nhập, trả về JWT access_token",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ],
              "variable": []
            },
            "description": "Đăng nhập, trả về JWT access_token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set(\"accessToken\", response.access_token);",
                  "    pm.environment.set(\"accessToken\", response.access_token);",
                  "    console.log(\"Đã tự động lưu access_token vào Postman Variable!\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "/api/auth/me Lấy thông tin người dùng hiện tại",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ],
              "variable": []
            },
            "description": "Lấy thông tin người dùng hiện tại"
          },
          "response": []
        }
      ]
    },
