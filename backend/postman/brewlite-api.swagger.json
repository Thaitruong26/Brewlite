  "info": {
    "title": "BrewLite API",
    "description": "Tài liệu OpenAPI / Swagger cho hệ thống bán cà phê BrewLite (Assignment 1). Hỗ trợ xác thực JWT Bearer, quản lý sản phẩm, tồn kho định lượng nguyên liệu, đặt hàng, xử lý thanh toán tiền mặt & kiểm kê kho.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Đăng ký, đăng nhập và xác thực người dùng"
    },
    {
      "name": "Products",
      "description": "Quản lý danh mục thực đơn và công thức pha chế sản phẩm"
    },
    {
      "name": "Toppings",
      "description": "Quản lý danh sách và định lượng nguyên liệu topping"
    },
    {
      "name": "Ingredients",
      "description": "Quản lý kho nguyên vật liệu, cảnh báo tồn kho và lịch sử biến động"
    },
    {
      "name": "Orders",
      "description": "Đặt hàng, xem danh sách và cập nhật trạng thái đơn"
    },
    {
      "name": "Payments",
      "description": "Thanh toán trực tiếp hỗ trợ Idempotency Key"
    },
    {
      "name": "Promotions",
      "description": "Kiểm tra và áp dụng mã voucher giảm giá"
    },
    {
      "name": "Health",
      "description": "Kiểm tra trạng thái máy chủ và kết nối cơ sở dữ liệu"
    },
    {
      "name": "App",
      "description": "Kiểm tra hoạt động dịch vụ gốc"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Nhập access_token nhận được từ /api/auth/login"
      }
    },
    "schemas": {
      "CreateIngredientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Tên nguyên liệu (duy nhất)",
            "example": "Đường"
          },
          "unit": {
            "type": "string",
            "description": "Đơn vị đo",
            "enum": [
              "G",
              "ML",
              "PCS"
            ],
            "example": "G"
          },
          "stock": {
            "type": "number",
            "description": "Tồn kho ban đầu",
            "example": 5000,
            "default": 0
          },
          "lowThreshold": {
            "type": "number",
            "description": "Ngưỡng cảnh báo sắp hết",
            "example": 500,
            "default": 0
          }
        },
        "required": [
          "name",
          "unit"
        ]
      },
      "UpdateIngredientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Tên nguyên liệu",
            "example": "Đường mía"
          },
          "lowThreshold": {
            "type": "number",
            "description": "Ngưỡng cảnh báo sắp hết",
            "example": 800
          }
        }
      },
      "AddIngredientStockDto": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "number",
            "description": "Số lượng nhập thêm",
            "example": 5000,
            "minimum": 1,
            "maximum": 1000000
          },
          "note": {
            "type": "string",
            "description": "Ghi chú lý do nhập hàng",
            "example": "Nhập hàng sáng"
          }
        },
        "required": [
          "quantity"
        ]
      },
      "AdjustIngredientStockDto": {
        "type": "object",
        "properties": {
          "actualStock": {
            "type": "number",
            "description": "Số tồn thực tế đếm được sau kiểm kê",
            "example": 1750,
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "description": "Lý do điều chỉnh kiểm kê hoặc hao hụt",
            "example": "Đổ vỡ 50ml khi pha"
          }
        },
        "required": [
          "actualStock",
          "reason"
        ]
      },
      "RecipeItemDto": {
        "type": "object",
        "properties": {
          "ingredientId": {
            "type": "number",
            "description": "ID nguyên liệu",
            "example": 1
          },
          "quantity": {
            "type": "number",
            "description": "Định lượng (size M với món, 1 phần với topping)",
            "example": 18
          }
        },
        "required": [
          "ingredientId",
          "quantity"
        ]
      },
      "UpdateRecipeDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Danh sách nguyên liệu trong công thức (tối đa 20 dòng, gửi [] để xóa)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecipeItemDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@brewlite.com"
          },
          "password": {
            "type": "string",
            "example": "Secret@123",
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "example": "Nguyễn Văn A"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@brewlite.com"
          },
          "password": {
            "type": "string",
            "example": "Secret@123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateOrderItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "number",
            "description": "ID của sản phẩm",
            "example": 3
          },
          "size": {
            "type": "string",
            "description": "Size đồ uống (S, M, L)",
            "enum": [
              "S",
              "M",
              "L"
            ],
            "example": "M"
          },
          "toppingIds": {
            "description": "Danh sách ID topping (tối đa 3 topping)",
            "example": [
              1
            ],
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "quantity": {
            "type": "number",
            "description": "Số lượng ly",
            "example": 1,
            "minimum": 1,
            "maximum": 20
          },
          "note": {
            "type": "string",
            "description": "Ghi chú cho món (ví dụ: ít đá, ít ngọt)",
            "example": "ít đá"
          }
        },
        "required": [
          "productId",
          "size",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Danh sách các món đồ uống trong giỏ hàng (1 - 30 món)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemDto"
            }
          },
          "promoCode": {
            "type": "string",
            "description": "Mã giảm giá áp dụng (nếu có)",
            "example": "BREW10"
          },
          "usePoints": {
            "type": "boolean",
            "description": "Sử dụng điểm tích lũy để giảm giá (100 điểm = 1.000đ)",
            "example": true
          }
        },
        "required": [
          "items"
        ]
      },
      "UpdateOrderStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Trạng thái chuyển tiếp tiếp theo (PAID, PREPARING, READY, COMPLETED)",
            "enum": [
              "PAID",
              "PREPARING",
              "READY",
              "COMPLETED"
            ],
            "example": "PAID"
          }
        },
        "required": [
          "status"
        ]
      },
      "CreatePaymentDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "number",
            "example": 1,
            "description": "ID của đơn hàng cần thanh toán"
          },
          "method": {
            "type": "string",
            "enum": [
              "WALLET",
              "CARD"
            ],
            "example": "WALLET",
            "description": "Phương thức thanh toán: WALLET hoặc CARD"
          },
          "mockResult": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "FAILED"
            ],
            "example": "SUCCESS",
            "description": "Mô phỏng kết quả thanh toán: SUCCESS hoặc FAILED (dùng khi demo/test)"
          }
        },
        "required": [
          "orderId",
          "method"
        ]
      },
      "ValidatePromotionDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Mã khuyến mãi",
            "example": "BREW10"
          },
          "orderValue": {
            "type": "number",
            "description": "Giá trị đơn hàng (nếu truyền trực tiếp)",
            "example": 100000
          },
          "items": {
            "description": "Danh sách món trong giỏ để server tự tính giá trị đơn",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemDto"
            }
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}