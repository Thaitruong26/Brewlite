<svg xmlns="http://www.w3.org/2000/svg" width="600" height="600" viewBox="0 0 600 600">
  <defs>
    <radialGradient id="bg" cx="50%" cy="40%">
      <stop offset="0%" stop-color="#bcaaa4"/>
      <stop offset="100%" stop-color="#3e2723"/>
    </radialGradient>
    <linearGradient id="coffee" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#4e342e"/>
      <stop offset="100%" stop-color="#1a0a00"/>
    </linearGradient>
  </defs>
  <rect width="600" height="600" fill="#100800"/>
  <rect width="600" height="600" fill="url(#bg)" opacity="0.1"/>
  <!-- Glass -->
  <path d="M205 175 L225 425 H375 L395 175 Z" fill="url(#coffee)" opacity="0.9"/>
  <rect x="205" y="167" width="190" height="18" rx="9" fill="#5d4037"/>
  <!-- Salted cream layer (top) -->
  <path d="M205 175 L395 175 L385 220 H215 Z" fill="#f5f5f5" opacity="0.88"/>
  <!-- Salt crystals shimmer -->
  <circle cx="250" cy="198" r="3" fill="white" opacity="0.9"/>
  <circle cx="270" cy="205" r="2" fill="white" opacity="0.7"/>
  <circle cx="310" cy="195" r="3" fill="white" opacity="0.8"/>
  <circle cx="345" cy="202" r="2.5" fill="white" opacity="0.9"/>
  <circle cx="290" cy="210" r="2" fill="white" opacity="0.6"/>
  <!-- Espresso gradient layers -->
  <rect x="215" y="220" width="170" height="60" fill="#3e2723" opacity="0.6"/>
  <!-- Label -->
  <text x="300" y="490" font-family="'Segoe UI', sans-serif" font-size="26" fill="#d7ccc8" text-anchor="middle" font-weight="bold">Cà phê muối</text>
  <text x="300" y="525" font-family="'Segoe UI', sans-serif" font-size="18" fill="#bcaaa4" text-anchor="middle">42.000 ₫</text>
</svg>
